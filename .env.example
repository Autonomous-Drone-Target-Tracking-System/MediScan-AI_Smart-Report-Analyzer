# ============================================================
# MediScan AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================

# Backend — AI (Groq)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Backend — OCR (OCR.space)
# Get your key from: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# CORS — Frontend origin allowed by the backend
FRONTEND_URL=http://localhost:3000

# Frontend (Next.js) — Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
