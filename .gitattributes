# Set default behavior to automatically normalize line endings.
* text=auto

# Force bash scripts to always use LF line endings
*.sh text eol=lf

# Python files
*.py text eol=lf

# TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.mts text eol=lf

# JSON / Config
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf

# Binaries — do not touch
*.docx binary
*.db binary
*.sqlite binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.pdf binary
